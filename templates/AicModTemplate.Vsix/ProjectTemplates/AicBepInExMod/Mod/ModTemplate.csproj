<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>$safeprojectname$</RootNamespace>
    <AssemblyName>$safeprojectname$</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- 程序集信息由 Properties\AssemblyInfo.cs 提供 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 保持与旧式工程一致的输出布局 bin\Debug\，便于拷贝到游戏 plugins 目录 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 引用来自解决方案根的 ReferenceLibrary，先运行本目录下的 setup-references.ps1 填充 -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\ReferenceLibrary\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\ReferenceLibrary\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\ReferenceLibrary\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\ReferenceLibrary\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\ReferenceLibrary\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\ReferenceLibrary\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\ReferenceLibrary\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="unsafeAssem">
      <HintPath>..\ReferenceLibrary\unsafeAssem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityModBase">
      <HintPath>..\ReferenceLibrary\UnityModBase.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityModBase.BepInExLauncher">
      <HintPath>..\ReferenceLibrary\UnityModBase.BepInExLauncher.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="setup-references.ps1" />
    <None Include="README-DEV.md" />
  </ItemGroup>

</Project>
